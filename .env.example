# =============================================================================
# eatMap 环境变量示例
# 复制为：
#   - 本地开发：.env.local      （npm run dev 自动加载，勿提交）
#   - 生产部署：.env.production （npm run build / next start / PM2 读取，勿提交）
# 生成随机密钥：openssl rand -base64 32
# =============================================================================

# —— 生产必填 ——
# 会话 JWT 的 HS256 签名密钥，至少 32 个字符；不要使用示例值，也不要提交真实值。
EATMAP_SECRET=

# 站点对外可访问的根 URL（含协议，不要写结尾斜杠）。
# 部署在域名根路径：https://example.com
# 部署在子路径（如 /eatmap）：https://example.com/eatmap
NEXT_PUBLIC_SITE_URL=https://example.com

# —— 可选：子路径部署 ——
# 应用挂载的子路径（无结尾斜杠）。根路径部署请留空。
# 若 NEXT_PUBLIC_SITE_URL 已包含路径，next.config 会自动推断，通常无需重复填写。
# EATMAP_BASE_PATH=/eatmap

# —— 可选：运行时 ——
# 监听端口（默认 4000，需与 ecosystem / Nginx 保持一致）
# PORT=4000

# JSON 数据目录（默认：仓库根目录下 ./data）。多实例或容器化时建议写绝对路径。
# EATMAP_DATA_DIR=/srv/eatmap/data

# 用户数据备份：启动时与每日北京时间 04:00 将整个数据目录复制到 {EATMAP_BACKUP_DIR}/latest
# 默认 ./data-backup（生产环境默认开启；本地开发需显式设为 1）
# EATMAP_BACKUP_DIR=/srv/eatmap/backup
# EATMAP_USER_DATA_BACKUP=1
# EATMAP_BACKUP_DISABLED=1

# 生产环境默认不打印每条 HTTP 请求；排查时设为 1
# EATMAP_DEBUG_HTTP=1

# 仅用于内网 / 测试环境：允许 NEXT_PUBLIC_SITE_URL 使用 http://（生产务必走 HTTPS）
# EATMAP_ALLOW_INSECURE_SITE_URL=0

# 设为 0 可关闭生产启动时的简短横幅日志
# EATMAP_START_BANNER=0
