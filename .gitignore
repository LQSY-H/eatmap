# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
/.next/
/out/
/build

# runtime data & uploads (keep the JSON seeds, ignore uploaded binaries)
/data/uploads/*
!/data/uploads/.gitkeep

# local backup snapshots
/data-backup/

# env files
.env
.env*.local
.env.production
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pm2-*.log

# vercel
.vercel
